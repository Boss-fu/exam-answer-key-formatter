__pycache__/
*.pyc
local-app/.venv-ocr/

# Node
node_modules/
package-lock.json

# 本機應用產出的 Word
local-app/output/

# OS
.DS_Store
Thumbs.db

# 圖片考卷暫存（讀圖用）
.exam-tmp-*/

# OCR 評測產出
ocr/results/

# 本機考卷資料與驗證暫存；避免誤推私人考卷或辨識內容
/output/
/tmp/

# Vercel 只部署 local-app/public，不包含主機工作檔
.vercel/

# OCR 模型（大檔，本地放 ocr/models/，不進 git）
ocr/models/*.onnx
ocr/testset/*.pdf
ocr/testset/*.png
ocr/testset/*.jpg
ocr/testset/*.gt.json
ocr/testset/*.docx
ocr/models/server/
ocr/holdout/

# 去筆跡訓練資料（含學生考卷）與模型輸出
ocr/dehand/data/
ocr/dehand/runs/
ocr/labels/
scratch/

# Codex 執行時產生的暫存檔、ONNX 外部權重
:memory:*
ocr/models/*.onnx.data
ocr/labels/
